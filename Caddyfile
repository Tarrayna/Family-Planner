# calendar.home / calendar-read.home — LAN only, or reached through a
# reverse proxy in front (e.g. Nginx Proxy Manager) that holds its own real
# certificate.
#
# Two hostnames, two experiences on the same app:
#   calendar.home       the interactive phone/family app
#   calendar-read.home  read-only TV view — always the calendar, never asks
#                        who's using it. Same app, same api, just a
#                        different landing page.
#
# The PWA needs real HTTPS for its service worker, hence tls internal below.
# Each device must trust Caddy's root CA once
# (/data/caddy/pki/authorities/local/root.crt) to use either hostname
# directly — not needed when reached through a front door that already
# presents its own trusted certificate (that proxy's connection to Caddy is
# just a backend hop, which such proxies don't validate by default).

# default_sni: a proxy in front of Caddy typically won't forward SNI on its
# connection to the backend (nginx-based ones don't by default), so without
# this Caddy can't tell which certificate to present and the handshake
# fails. Doesn't affect which of the two sites below actually handles the
# request — that's decided by the Host header once the request is
# decrypted, same either way.
{
	default_sni calendar.home
}

(shared_backend) {
	handle /api/* {
		reverse_proxy api:8080
	}

	handle /photos/* {
		reverse_proxy api:8080
		# Same reasoning as the no-cache header below: a person's photo URL
		# never changes even when a re-uploaded photo's content does, so
		# without forcing revalidation the browser can keep showing an old
		# picture indefinitely after a re-upload.
		header Cache-Control "no-cache"
	}

	# Lets a device grab the CA's public certificate from Settings instead of
	# a manual docker compose cp + file transfer per device. Scoped to this
	# exact path and hard-rewritten to this exact filename on purpose — the
	# PKI directory also holds root.key (and an intermediate cert/key) right
	# next to root.crt, and root.key must never be reachable: it's what lets
	# whoever holds it mint certificates any device that's installed this CA
	# would trust.
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type "application/x-x509-ca-cert"
		file_server
	}
}

calendar.home {
	tls internal
	import shared_backend

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		# Force revalidation on every request (still cheap via ETag/304) —
		# this app is under active development and phones were repeatedly
		# showing stale HTML/CSS/JS from heuristic caching (no explicit
		# Cache-Control means browsers may serve from cache without even
		# asking the server). A manual reload should always reflect what's
		# actually on disk.
		header Cache-Control "no-cache"
	}

	encode gzip
}

calendar-read.home {
	tls internal
	import shared_backend

	handle {
		root * /srv/web
		@root path /
		rewrite @root /tv.html
		try_files {path} /tv.html
		file_server
		header Cache-Control "no-cache"
	}

	encode gzip
}
