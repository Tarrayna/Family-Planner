# planner.home — LAN only.
#
# The PWA needs real HTTPS for its service worker. Two workable routes:
#
#  A) You own a domain: use a DNS-01 challenge so no port needs to be open.
#     Requires a Caddy build with your DNS provider's plugin.
#
#  B) Internal CA (below): Caddy issues its own cert. Works immediately, but
#     each device must trust Caddy's root CA once
#     (/data/caddy/pki/authorities/local/root.crt) or the service worker
#     will not register.

#  Dev-only: this box's current LAN IP is listed as an alternate address so
#  phones can reach it without any router DNS setup. Update it if the IP
#  changes, or drop it once planner.home resolves for real. default_sni is
#  required too: browsers send no SNI for a literal IP, so without it Caddy
#  can't pick which cert to present and the handshake fails.
{
	default_sni 192.168.1.126
}

planner.home, 192.168.1.126 {
	tls internal

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /photos/* {
		reverse_proxy api:8080
		# Same reasoning as the no-cache header below: a person's photo URL
		# never changes even when a re-uploaded photo's content does, so
		# without forcing revalidation the browser can keep showing an old
		# picture indefinitely after a re-upload.
		header Cache-Control "no-cache"
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
		# Force revalidation on every request (still cheap via ETag/304) —
		# this app is under active development and phones were repeatedly
		# showing stale HTML/CSS/JS from heuristic caching (no explicit
		# Cache-Control means browsers may serve from cache without even
		# asking the server). A manual reload should always reflect what's
		# actually on disk.
		header Cache-Control "no-cache"
	}

	encode gzip
}
